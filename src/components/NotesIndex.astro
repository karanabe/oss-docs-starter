---
import { getCollection } from 'astro:content';

interface Props {
	locale: 'en' | 'ja';
}

const { locale } = Astro.props;
const isJapanese = locale === 'ja';
const notesRoot = isJapanese ? 'ja/notes' : 'notes';
const copy = isJapanese
	? {
			empty: 'まだメモはありません。最初のMarkdownファイルを追加すると、ここに表示されます。',
			updated: '更新',
		}
	: {
			empty: 'No notes yet. Add the first Markdown file and it will appear here.',
			updated: 'Updated',
		};

const notes = (await getCollection('docs'))
	.filter((entry) =>
		entry.id.startsWith(`${notesRoot}/`) &&
		entry.id !== `${notesRoot}/index` &&
		entry.id !== `${notesRoot}/tags` &&
		!entry.data.draft
	)
	.map((entry) => {
		const path = entry.id.replace(/(^|\/)index$/, '$1').replace(/\/$/, '');
		return {
			date: entry.data.updatedAt ?? entry.data.publishedAt,
			description: entry.data.description,
			href: `/${path}/`,
			publishedAt: entry.data.publishedAt,
			tags: entry.data.tags,
			title: entry.data.title,
			updatedAt: entry.data.updatedAt,
		};
	})
	.sort((a, b) => {
		const byDate =
			(b.publishedAt?.getTime() ?? b.updatedAt?.getTime() ?? 0) -
			(a.publishedAt?.getTime() ?? a.updatedAt?.getTime() ?? 0);
		return byDate || a.title.localeCompare(b.title, locale);
	});

const dateFormatter = new Intl.DateTimeFormat(isJapanese ? 'ja-JP' : 'en', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<div class="notes-index not-content">
	{
		notes.length > 0 ? (
			<ol class="notes-list">
				{notes.map((note) => (
					<li>
						<article>
							<a href={note.href}>
								<h3>{note.title}</h3>
								{note.description && <p>{note.description}</p>}
							</a>
							{(note.date || note.tags.length > 0) && (
								<footer>
									{note.date && (
										<time datetime={note.date.toISOString()}>
											{note.updatedAt && `${copy.updated} `}{dateFormatter.format(note.date)}
										</time>
									)}
									{note.tags.length > 0 && (
										<ul aria-label={isJapanese ? 'タグ' : 'Tags'}>
											{note.tags.map((tag) => <li>{tag}</li>)}
										</ul>
									)}
								</footer>
							)}
						</article>
					</li>
				))}
			</ol>
		) : (
			<p class="notes-empty">{copy.empty}</p>
		)
	}
</div>

<style>
	.notes-index {
		display: grid;
		gap: 1rem;
		margin-top: 2rem;
	}

	.notes-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.notes-list article {
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--project-content-radius);
		background: var(--sl-color-black);
		padding: clamp(1rem, 3vw, 1.35rem);
	}

	.notes-list article > a {
		display: block;
		border-radius: 0.35rem;
		color: inherit;
		text-decoration: none;
	}

	.notes-list article:has(> a:hover),
	.notes-list article:has(> a:focus-visible) {
		border-color: var(--project-accent-border);
	}

	.notes-list article > a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 4px;
	}

	.notes-list h3 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-xl);
		line-height: 1.4;
	}

	.notes-list p {
		margin: 0.5rem 0 0;
		color: var(--sl-color-gray-2);
		line-height: 1.65;
	}

	.notes-list footer {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
		margin-top: 0.9rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.notes-list time {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.notes-list footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.notes-list footer li {
		border-radius: 999px;
		background: var(--project-accent-soft);
		padding: 0.2rem 0.5rem;
		color: var(--sl-color-accent-high);
	}

	.notes-empty {
		margin: 0;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: var(--project-content-radius);
		padding: 1rem;
		color: var(--sl-color-gray-2);
	}
</style>
